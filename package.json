{
  "name": "voccy",
  "version": "2.0.0",
  "private": true,
  "description": "Offline vocabulary learning for Windows",
  "author": "gen-nakamura",
  "license": "ISC",
  "main": "electron/main.cjs",
  "engines": {
    "node": ">=24.22.1 <25",
    "npm": ">=12.2.1"
  },
  "scripts": {
    "build": "vite build",
    "start": "electron .",
    "dev": "npm run build && electron .",
    "lint": "eslint .",
    "test": "node --test tests/*.test.cjs",
    "pack": "npm run build && electron-builder --win --x64 --dir --publish never",
    "dist": "npm run build && electron-builder --win nsis --x64 --publish never",
    "electron:build": "npm run dist"
  },
  "dependencies": {},
  "devDependencies": {
    "vue": "3.5.44",
    "vite": "8.3.5",
    "@vitejs/plugin-vue": "6.0.10",
    "electron": "45.2.1",
    "electron-builder": "26.18.0",
    "eslint": "10.14.0",
    "eslint-plugin-vue": "10.12.0"
  },
  "build": {
    "appId": "voccy_gen-nakamura",
    "productName": "Voccy",
    "asar": true,
    "npmRebuild": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*.cjs",
      "src/build/icon.png",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "src/build/icon.png",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false
    },
    "publish": null
  },
  "overrides": {
    "minimatch": "11.0.3",
    "dir-compare": "5.0.0",
    "@electron/asar": {
      "glob": "14.0.2",
      ".": "4.3.1"
    }
  }
}
